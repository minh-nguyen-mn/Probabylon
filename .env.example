# Shared platform configuration
APP_ENV=development
LOG_LEVEL=INFO

# Frontend runtime
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/markets

# Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Runtime traffic should use the pooled Neon/Supabase connection.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/probabylon
# Alembic migrations and schema operations should use the unpooled connection.
DATABASE_URL_UNPOOLED=postgresql+psycopg://postgres:postgres@db:5432/probabylon

# Redis / workers
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/1
RESULT_BACKEND=redis://redis:6379/2

# Auth
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI / AI orchestration
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# AI hook logging
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
