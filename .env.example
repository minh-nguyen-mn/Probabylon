# Choose one or both providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=or-...
GROQ_API_KEY=gsk_...

# Optional model overrides
# If OPENAI_API_KEY is set, the app now defaults to OpenAI automatically.
DEFAULT_MODEL=gpt-4o-mini
MODEL_CHAT=gpt-4o-mini
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
# For OpenRouter, prefer one of:
# DEFAULT_LLM_PROVIDER=openrouter
# DEFAULT_LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log

# Production infra
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/probabylon
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/1
RESULT_BACKEND=redis://redis:6379/2
